<?xml version="1.0" encoding="UTF-8"?>
<!--
  项目: WiFi Data Manager
  版本: 1.0
  Tasker版本: >= 6.0 (tv=6.6.20)
  描述: 连接WiFi时自动关闭移动数据，断开时自动恢复。
  导入方法: 保存为 .prj.xml 文件，放入 /sdcard/Tasker/ 目录后导入。
-->
<TaskerData sr="" dvi="1" tv="6.6.20">

  <Project sr="proj0" ve="2">
    <cdate>1700000000000</cdate>
    <name>WiFi Data Manager</name>
    <pids>102</pids>
    <tids>202</tids>
    <Share sr="Share">
      <b>false</b>
      <d>连接WiFi时自动关闭移动数据，断开时自动恢复。</d>
      <g>Data</g>
      <p>true</p>
      <t>network,wifi</t>
    </Share>
  </Project>

  <!-- =============================================================
       Profile 102: WiFi 连接状态
       触发: State — 已连接 WiFi
       入口: Task 202 — 关闭移动数据
       出口: Task 202 — 开启移动数据
       %caller1 = enter (入口: WiFi连接) / exit (出口: WiFi断开)
  ============================================================= -->
  <Profile sr="prof102" ve="2">
    <cdate>1700000000000</cdate>
    <clp>true</clp>
    <edate>1700000000000</edate>
    <flags>40</flags>
    <id>102</id>
    <mid0>202</mid0>
    <mid1>202</mid1>
    <nme>WiFi Connected - Toggle Data</nme>
    <State sr="con0" ve="2">
      <code>39</code>
      <Str sr="arg0" ve="3">*</Str>
      <Str sr="arg1" ve="3"/>
      <Int sr="arg2" val="0"/>
    </State>
  </Profile>

  <!-- =============================================================
       Task 202: 切换移动数据
       通过 %caller1 区分入口/出口:
         %caller1 = enter (入口: WiFi 连接)  → 关闭移动数据
         %caller1 = exit  (出口: WiFi 断开)  → 开启移动数据
  ============================================================= -->
  <Task sr="task202">
    <cdate>1700000000000</cdate>
    <edate>1700000000000</edate>
    <id>202</id>
    <pri>5</pri>
    <rty>1</rty>
    <CollisionT>30000</CollisionT>

    <!-- Action 0: If — 入口（WiFi 连上了） -->
    <Action sr="act0" ve="7">
      <code>37</code>
      <ConditionList sr="if">
        <IfCondition sr="c0" ve="3">
          <lhs>%caller1</lhs>
          <op>0</op>
          <rhs>enter</rhs>
        </IfCondition>
      </ConditionList>
    </Action>

    <!-- Action 1: Mobile Data — 关闭 -->
    <Action sr="act1" ve="7">
      <code>14</code>
      <Int sr="arg0" val="0"/>
    </Action>

    <!-- Action 2: Flash — 确认提示 -->
    <Action sr="act2" ve="7">
      <code>548</code>
      <Str sr="arg0" ve="3">已连接 WiFi，移动数据已关闭</Str>
      <Int sr="arg1" val="0"/>
      <Int sr="arg2" val="0"/>
    </Action>

    <!-- Action 3: Else — 出口（WiFi 断开了） -->
    <Action sr="act3" ve="7">
      <code>38</code>
    </Action>

    <!-- Action 4: Mobile Data — 开启 -->
    <Action sr="act4" ve="7">
      <code>14</code>
      <Int sr="arg0" val="1"/>
    </Action>

    <!-- Action 5: Flash — 确认提示 -->
    <Action sr="act5" ve="7">
      <code>548</code>
      <Str sr="arg0" ve="3">WiFi 已断开，移动数据已恢复</Str>
      <Int sr="arg1" val="0"/>
      <Int sr="arg2" val="0"/>
    </Action>

    <!-- Action 6: End If -->
    <Action sr="act6" ve="7">
      <code>39</code>
    </Action>

    <!-- Action 7: Wait — 2秒防抖 -->
    <Action sr="act7" ve="7">
      <code>30</code>
      <Int sr="arg0" val="1"/>
      <Int sr="arg1" val="0"/>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="0"/>
    </Action>

  </Task>

</TaskerData>

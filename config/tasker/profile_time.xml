<?xml version="1.0" encoding="utf-8"?>
<TaskerData version="1.0" tv="5.15.0" dvi="1" rvi="1">
  <!-- ================================================================
       Profile: ATLAS 定时触发
       名称: ATLAS: 定时SIM切换 08:55
       触发: 每日 08:55 (时间 = 535 分钟 from midnight)
       任务: ATLAS: SIM切换
       用途: 工作日上午自动将 SIM 切换到主卡
  ================================================================ -->
  <Profile sr="prof_time" ve="2">
    <cdate>1723104000000</cdate>
    <edate>1743187200000</edate>
    <id>1001</id>
    <flags>8</flags>
    <mid0>1001</mid0>
    <nme>ATLAS: 定时SIM切换 08:55</nme>

    <!-- 时间上下文: 08:55 (535 分钟 from midnight) -->
    <Time sr="con0" ve="2">
      <code>100</code>
      <Repeat>0</Repeat>
      <From>535</From>
      <To>535</To>
    </Time>

    <!-- 关联 Task -->
    <Task sr="task_sim_switch"/>
  </Profile>

  <!-- ================================================================
       Task: ATLAS: SIM切换
       (完整 Action 定义，可在项目文件中引用)
  ================================================================ -->
  <Task sr="task_sim_switch">
    <cdate>1723104000000</cdate>
    <edate>1743187200000</edate>
    <id>2001</id>
    <nme>ATLAS: SIM切换</nme>
    <pri>10</pri>
    <rty>1</rty>

    <!-- Action 1: Variable Set — %action_json -->
    <Action sr="act0" ve="7">
      <code>547</code>
      <Str sr="arg0" ve="3">%action_json</Str>
      <Str sr="arg1" ve="3">{"action":"sim_switch","params":{"slot":0},"correlation_id":"tasker_sim_%TIMES"}</Str>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="0"/>
      <Int sr="arg5" val="0"/>
      <Int sr="arg6" val="0"/>
    </Action>

    <!-- Action 2: Termux:Tasker — trigger_atlas.sh -->
    <Action sr="act1" ve="7">
      <code>1342177284</code>
      <Bundle sr="arg0">
        <key>com.termux.tasker.ARGUMENTS</key>
        <value>runtime/trigger_atlas.sh %action_json</value>
        <key>com.termux.tasker.EXECUTABLE</key>
        <value>/data/data/com.termux/files/usr/bin/bash</value>
        <key>com.termux.tasker.TIMEOUT</key>
        <value>30</value>
        <key>com.termux.tasker.WORKDIR</key>
        <value>/data/data/com.termux/files/home/atlas-runtime</value>
      </Bundle>
      <Str sr="arg1" ve="3">com.termux.tasker</Str>
      <Str sr="arg2" ve="3">com.termux.tasker.TaskerReceiver</Str>
      <Int sr="arg3" val="0"/>
    </Action>

    <!-- Action 3: Wait 5s -->
    <Action sr="act2" ve="7">
      <code>30</code>
      <Int sr="arg0" val="5"/>
      <Int sr="arg1" val="0"/>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="0"/>
    </Action>

    <!-- Action 4: Read File — /sdcard/atlas_shared/last_result.json -->
    <Action sr="act3" ve="7">
      <code>417</code>
      <Str sr="arg0" ve="3">/sdcard/atlas_shared/last_result.json</Str>
      <Str sr="arg1" ve="3">%result_raw</Str>
    </Action>

    <!-- Action 5: Notify — 显示结果 -->
    <Action sr="act4" ve="7">
      <code>523</code>
      <Str sr="arg0" ve="3">Atlas: SIM 切换完成</Str>
      <Str sr="arg1" ve="3">%result_raw</Str>
      <Str sr="arg2" ve="3"/>
      <Str sr="arg3" ve="3"/>
      <Str sr="arg4" ve="3"/>
      <Str sr="arg5" ve="3">ic_launcher</Str>
      <Int sr="arg6" val="0"/>
      <Int sr="arg7" val="0"/>
      <Int sr="arg8" val="0"/>
    </Action>
  </Task>
</TaskerData>

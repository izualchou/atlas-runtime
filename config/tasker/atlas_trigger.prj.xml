<?xml version="1.0" encoding="utf-8"?>
<TaskerData version="1.0" tv="5.15.0" dvi="1" rvi="1">
  <!-- ================================================================
       Atlas Trigger — Tasker 项目文件
       版本: v2.0 (修复版)
       说明: 聚合所有 Atlas Runtime 的 Profile 和 Task，
             可使用 Tasker 的 "导入项目" 功能直接导入。
       依赖: Termux:Tasker 插件、AutoNotification 插件 (可选)
             详见项目 REAMDE 及 docs/ 目录下的部署指南。
  ================================================================ -->

  <!-- ================================================================
       Project 定义
  ================================================================ -->
  <Project sr="proj0" ve="2">
    <cdate>1723104000000</cdate>
    <name>Atlas Trigger</name>
    <pids>1001,1002,1003</pids>
    <tids>2001,2002,2003,2004</tids>
    <desc>Atlas Runtime 自动化触发项目 — 管理 SIM 切换、WiFi 控制、通用触发和结果通知</desc>
  </Project>

  <!-- ================================================================
       Profile 1: 定时触发 (每日 08:55 SIM 切换)
  ================================================================ -->
  <Profile sr="prof_time" ve="2">
    <cdate>1723104000000</cdate>
    <edate>1723104000000</edate>
    <id>1001</id>
    <flags>8</flags>
    <mid0>2001</mid0>
    <nme>ATLAS: 定时SIM切换 08:55</nme>
    <Time sr="con0" ve="2">
      <fh>8</fh>
      <fm>55</fm>
      <th>8</th>
      <tm>55</tm>
    </Time>
  </Profile>

  <!-- ================================================================
       Profile 2: 事件触发 (收到特定通知)
  ================================================================ -->
  <Profile sr="prof_event" ve="2">
    <cdate>1723104000000</cdate>
    <edate>1723104000000</edate>
    <id>1002</id>
    <flags>8</flags>
    <mid0>2003</mid0>
    <nme>ATLAS: 事件-通知触发</nme>
    <!-- 
      AutoNotification Intercept — 监听指定应用的推送通知
      依赖: AutoNotification 插件 (com.joaomgcd.autonotification)
      原生替代: 可用 Tasker 内置 Event → Notification (限制较多)
      plugin.EB 是 Tasker 对 Event Behaviour 插件的标准XML节点，
      state="2" 表示事件响应型插件，这是 Tasker 原生支持的格式。
    -->
    <plugin.EB state="2" sr="con0" ve="2">
      <code>200</code>
      <Bundle sr="arg0">
        <key>NotificationApp</key>
        <value>Messages,SMS</value>
        <key>NotificationTextFilter</key>
        <value></value>
      </Bundle>
      <Str sr="arg0" ve="3">com.joaomgcd.autonotification</Str>
      <Str sr="arg1" ve="3">AutoNotification Intercept</Str>
    </plugin.EB>
  </Profile>

  <!-- ================================================================
       Profile 3: 状态触发 (电量低于 20%)
  ================================================================ -->
  <Profile sr="prof_state" ve="2">
    <cdate>1723104000000</cdate>
    <edate>1723104000000</edate>
    <id>1003</id>
    <flags>8</flags>
    <mid0>2002</mid0>
    <nme>ATLAS: 状态-电量低于20%</nme>
    <State sr="con0" ve="2">
      <code>140</code>
      <Int sr="arg0" val="0"/>
      <Int sr="arg1" val="20"/>
    </State>
  </Profile>

  <!-- ================================================================
       Task 1: SIM 切换
       步骤: 获取当前 SIM → 构建 JSON → Termux:Tasker 调用 trigger_atlas.sh
       → 等待结果 → 通知用户
  ================================================================ -->
  <Task sr="task_sim_switch">
    <cdate>1723104000000</cdate>
    <edate>1723104000000</edate>
    <id>2001</id>
    <nme>ATLAS: SIM切换</nme>
    <pri>10</pri>
    <rty>1</rty>

    <!-- Action 1: Set Variable %action_json -->
    <Action sr="act0" ve="7">
      <code>547</code>
      <Str sr="arg0" ve="3">%action_json</Str>
      <Str sr="arg1" ve="3">{"action":"sim_switch","params":{"slot":0},"correlation_id":"tasker_sim_%TIMES"}</Str>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="0"/>
      <Int sr="arg5" val="0"/>
      <Int sr="arg6" val="0"/>
    </Action>

    <!-- Action 2: Termux:Tasker — 执行 trigger_atlas.sh -->
    <Action sr="act1" ve="7">
      <code>1342177284</code>
      <Bundle sr="arg0">
        <key>com.termux.tasker.ARGUMENTS</key>
        <value>runtime/trigger_atlas.sh %action_json</value>
        <key>com.termux.tasker.EXECUTABLE</key>
        <value>/data/data/com.termux/files/usr/bin/bash</value>
        <key>com.termux.tasker.INPUT</key>
        <value></value>
        <key>com.termux.tasker.TIMEOUT</key>
        <value>30</value>
        <key>com.termux.tasker.WORKDIR</key>
        <value>/data/data/com.termux/files/home/atlas-runtime</value>
      </Bundle>
      <Str sr="arg1" ve="3">com.termux.tasker</Str>
      <Str sr="arg2" ve="3">com.termux.tasker.TaskerReceiver</Str>
      <Int sr="arg3" val="0"/>
    </Action>

    <!-- Action 3: Wait 5 seconds for execution -->
    <Action sr="act2" ve="7">
      <code>30</code>
      <Int sr="arg0" val="5"/>
      <Int sr="arg1" val="0"/>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="0"/>
    </Action>

    <!-- Action 4: Read result from /sdcard/atlas_shared/last_result.json -->
    <Action sr="act3" ve="7">
      <code>417</code>
      <Str sr="arg0" ve="3">/sdcard/atlas_shared/last_result.json</Str>
      <Str sr="arg1" ve="3">%result_raw</Str>
    </Action>

    <!-- Action 5: Notify with result -->
    <Action sr="act4" ve="7">
      <code>523</code>
      <Str sr="arg0" ve="3">Atlas: SIM 切换</Str>
      <Str sr="arg1" ve="3">%result_raw</Str>
      <Str sr="arg2" ve="3"/>
      <Str sr="arg3" ve="3"/>
      <Str sr="arg4" ve="3"/>
      <Str sr="arg5" ve="3">ic_launcher</Str>
      <Int sr="arg6" val="0"/>
      <Int sr="arg7" val="0"/>
      <Int sr="arg8" val="0"/>
    </Action>
  </Task>

  <!-- ================================================================
       Task 2: WiFi 切换
       步骤: 获取当前 WiFi 状态 → 构建 JSON → Termux:Tasker 调用
  ================================================================ -->
  <Task sr="task_wifi_toggle">
    <cdate>1723104000000</cdate>
    <edate>1723104000000</edate>
    <id>2002</id>
    <nme>ATLAS: WiFi切换</nme>
    <pri>8</pri>
    <rty>1</rty>

    <!-- Action 1: Set Variable %wifi_action -->
    <Action sr="act0" ve="7">
      <code>547</code>
      <Str sr="arg0" ve="3">%wifi_action</Str>
      <Str sr="arg1" ve="3">{"action":"wifi_toggle","params":{"enable":true},"correlation_id":"tasker_wifi_%TIMES"}</Str>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="0"/>
      <Int sr="arg5" val="0"/>
      <Int sr="arg6" val="0"/>
    </Action>

    <!-- Action 2: Termux:Tasker — 执行 trigger_atlas.sh -->
    <Action sr="act1" ve="7">
      <code>1342177284</code>
      <Bundle sr="arg0">
        <key>com.termux.tasker.ARGUMENTS</key>
        <value>runtime/trigger_atlas.sh %wifi_action</value>
        <key>com.termux.tasker.EXECUTABLE</key>
        <value>/data/data/com.termux/files/usr/bin/bash</value>
        <key>com.termux.tasker.TIMEOUT</key>
        <value>15</value>
        <key>com.termux.tasker.WORKDIR</key>
        <value>/data/data/com.termux/files/home/atlas-runtime</value>
      </Bundle>
      <Str sr="arg1" ve="3">com.termux.tasker</Str>
      <Str sr="arg2" ve="3">com.termux.tasker.TaskerReceiver</Str>
      <Int sr="arg3" val="0"/>
    </Action>

    <!-- Action 3: Wait 3 seconds -->
    <Action sr="act2" ve="7">
      <code>30</code>
      <Int sr="arg0" val="3"/>
      <Int sr="arg1" val="0"/>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="0"/>
    </Action>

    <!-- Action 4: Notify -->
    <Action sr="act3" ve="7">
      <code>523</code>
      <Str sr="arg0" ve="3">Atlas: WiFi 切换</Str>
      <Str sr="arg1" ve="3">WiFi 切换命令已发送</Str>
      <Str sr="arg2" ve="3"/>
      <Str sr="arg3" ve="3"/>
      <Str sr="arg4" ve="3"/>
      <Str sr="arg5" ve="3">ic_launcher</Str>
      <Int sr="arg6" val="0"/>
      <Int sr="arg7" val="0"/>
      <Int sr="arg8" val="0"/>
    </Action>
  </Task>

  <!-- ================================================================
       Task 3: 通用触发 (可复用模板)
       说明: 使用 %par1 作为 action 名称，%par2 作为 JSON 参数
  ================================================================ -->
  <Task sr="task_trigger_universal">
    <cdate>1723104000000</cdate>
    <edate>1723104000000</edate>
    <id>2003</id>
    <nme>ATLAS: 通用触发</nme>
    <pri>5</pri>
    <rty>1</rty>

    <!-- Action 1: Build JSON from params -->
    <Action sr="act0" ve="7">
      <code>547</code>
      <Str sr="arg0" ve="3">%trigger_json</Str>
      <Str sr="arg1" ve="3">{"action":"%par1","params":%par2,"correlation_id":"tasker_%par1_%TIMES"}</Str>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="0"/>
      <Int sr="arg5" val="0"/>
      <Int sr="arg6" val="0"/>
    </Action>

    <!-- Action 2: Termux:Tasker — 执行 trigger_atlas.sh -->
    <Action sr="act1" ve="7">
      <code>1342177284</code>
      <Bundle sr="arg0">
        <key>com.termux.tasker.ARGUMENTS</key>
        <value>runtime/trigger_atlas.sh %trigger_json</value>
        <key>com.termux.tasker.EXECUTABLE</key>
        <value>/data/data/com.termux/files/usr/bin/bash</value>
        <key>com.termux.tasker.TIMEOUT</key>
        <value>30</value>
        <key>com.termux.tasker.WORKDIR</key>
        <value>/data/data/com.termux/files/home/atlas-runtime</value>
      </Bundle>
      <Str sr="arg1" ve="3">com.termux.tasker</Str>
      <Str sr="arg2" ve="3">com.termux.tasker.TaskerReceiver</Str>
      <Int sr="arg3" val="0"/>
    </Action>

    <!-- Action 3: Wait 3 seconds -->
    <Action sr="act2" ve="7">
      <code>30</code>
      <Int sr="arg0" val="3"/>
      <Int sr="arg1" val="0"/>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="0"/>
    </Action>

    <!-- Action 4: Read result -->
    <Action sr="act3" ve="7">
      <code>417</code>
      <Str sr="arg0" ve="3">/sdcard/atlas_shared/last_result.json</Str>
      <Str sr="arg1" ve="3">%result_raw</Str>
    </Action>
  </Task>

  <!-- ================================================================
       Task 4: 结果处理 (读取 + 通知 + 日志)
       说明: 从 /sdcard/atlas_shared/last_result.json 读取结果并展示
  ================================================================ -->
  <Task sr="task_result_handler">
    <cdate>1723104000000</cdate>
    <edate>1723104000000</edate>
    <id>2004</id>
    <nme>ATLAS: 结果处理</nme>
    <pri>5</pri>
    <rty>0</rty>

    <!-- Action 1: Read result JSON file -->
    <Action sr="act0" ve="7">
      <code>417</code>
      <Str sr="arg0" ve="3">/sdcard/atlas_shared/last_result.json</Str>
      <Str sr="arg1" ve="3">%result_content</Str>
    </Action>

    <!-- Action 2: Check if file was read successfully -->
    <Action sr="act1" ve="7">
      <code>37</code>
      <Str sr="arg0" ve="3">%result_content</Str>
      <Str sr="arg1" ve="3">Set</Str>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
    </Action>

    <!-- Action 3: JavaScriptlet — 解析 JSON 提取 status 字段 -->
    <!-- 
      原 code=413 是"请求添加快捷图块"的 Action，不可用于 JSON 解析。
      修正为 code=418 (JavaScriptlet)，这是 Tasker 原生支持的
      JavaScript 执行动作，通过 JSON.parse() 正确提取字段。
      JavaScriptlet 中的 local() 读取本地变量，setLocal() 写入本地变量。
    -->
    <Action sr="act2" ve="7">
      <code>418</code>
      <Str sr="arg0" ve="3">try { var r = JSON.parse(local("result_content")); setLocal("task_status", r.status || "unknown"); } catch(e) { setLocal("task_status", "parse_error"); }</Str>
      <Int sr="arg1" val="30"/>
    </Action>

    <!-- Action 4: Notify with status -->
    <Action sr="act3" ve="7">
      <code>523</code>
      <Str sr="arg0" ve="3">Atlas: 任务结果</Str>
      <Str sr="arg1" ve="3">状态: %task_status</Str>
      <Str sr="arg2" ve="3"/>
      <Str sr="arg3" ve="3"/>
      <Str sr="arg4" ve="3"/>
      <Str sr="arg5" ve="3">ic_menu_info_details</Str>
      <Int sr="arg6" val="0"/>
      <Int sr="arg7" val="0"/>
      <Int sr="arg8" val="0"/>
    </Action>

    <!-- Action 5: End If -->
    <Action sr="act4" ve="7">
      <code>38</code>
    </Action>
  </Task>
</TaskerData>

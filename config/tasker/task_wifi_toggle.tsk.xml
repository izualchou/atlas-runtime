<?xml version="1.0" encoding="utf-8"?>
<TaskerData version="1.0" tv="6.6.20" dvi="1" rvi="1">
  <!-- ================================================================
       Task: ATLAS: WiFi切换
       版本: v1.0
       步骤数: 6
       说明: 通过 Atlas Runtime 控制 WiFi 开关，支持启用/禁用。
       依赖: Termux:Tasker 插件、trigger_atlas.sh
  ================================================================ -->
  <Task sr="task_wifi_toggle">
    <cdate>1723104000000</cdate>
    <edate>1743187200000</edate>
    <id>2002</id>
    <nme>ATLAS: WiFi切换</nme>
    <pri>8</pri>
    <rty>1</rty>

    <!-- Action 1: Variable Set — 构建触发 JSON (含 enable 参数) -->
    <Action sr="act0" ve="7">
      <code>547</code>
      <Str sr="arg0" ve="3">%wifi_action</Str>
      <Str sr="arg1" ve="3">{"action":"wifi_toggle","params":{"enable":true},"correlation_id":"tasker_wifi_%TIMES"}</Str>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="0"/>
      <Int sr="arg5" val="0"/>
      <Int sr="arg6" val="0"/>
    </Action>

    <!-- Action 2: JavaScriptlet — 计算 Wi-Fi 切换目标状态 -->
    <!-- code=129 = JavaScriptlet (Tasker v6.6.20, was 418 Calendar Events) -->
    <Action sr="act1" ve="7">
      <code>129</code>
      <Str sr="arg0" ve="3">var enable = global("WIFI") !== "on";
setLocal("wifi_action", JSON.stringify({action:"wifi_toggle",params:{enable:enable},correlation_id:"tasker_wifi_"+global("TIMES")}));</Str>
      <Int sr="arg1" val="30"/>
    </Action>

    <!-- Action 3: Termux:Tasker — 调用 trigger_atlas.sh -->
    <Action sr="act2" ve="7">
      <code>1342177284</code>
      <Bundle sr="arg0">
        <key>com.termux.tasker.ARGUMENTS</key>
        <value>runtime/trigger_atlas.sh %wifi_action</value>
        <key>com.termux.tasker.EXECUTABLE</key>
        <value>/data/data/com.termux/files/usr/bin/bash</value>
        <key>com.termux.tasker.TIMEOUT</key>
        <value>15</value>
        <key>com.termux.tasker.WORKDIR</key>
        <value>/data/data/com.termux/files/home/atlas-runtime</value>
      </Bundle>
      <Str sr="arg1" ve="3">com.termux.tasker</Str>
      <Str sr="arg2" ve="3">com.termux.tasker.TaskerReceiver</Str>
      <Int sr="arg3" val="0"/>
    </Action>

    <!-- Action 4: Wait 3 seconds -->
    <Action sr="act3" ve="7">
      <code>30</code>
      <Int sr="arg0" val="3"/>
      <Int sr="arg1" val="0"/>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="0"/>
    </Action>

    <!-- Action 5: Notify -->
    <Action sr="act4" ve="7">
      <code>523</code>
      <Str sr="arg0" ve="3">Atlas: WiFi 控制</Str>
      <Str sr="arg1" ve="3">WiFi 切换命令已发送 (target=%wifi_action)</Str>
      <Str sr="arg2" ve="3"/>
      <Str sr="arg3" ve="3"/>
      <Str sr="arg4" ve="3"/>
      <Str sr="arg5" ve="3">ic_launcher</Str>
      <Int sr="arg6" val="0"/>
      <Int sr="arg7" val="0"/>
      <Int sr="arg8" val="0"/>
    </Action>
  </Task>
</TaskerData>

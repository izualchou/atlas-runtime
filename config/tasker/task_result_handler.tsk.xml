<?xml version="1.0" encoding="utf-8"?>
<TaskerData version="1.0" tv="6.6.20" dvi="1" rvi="1">
  <!-- ================================================================
       Task: ATLAS: 结果处理
       版本: v2.0
       步骤数: 7
       说明: 从 Atlas Runtime 共享目录读取 last_result.json，
             解析任务状态并向用户展示通知。包含错误处理和超时保护。
       依赖: result_callback.py (写入 last_result.json)
  ================================================================ -->
  <Task sr="task_result_handler">
    <cdate>1723104000000</cdate>
    <edate>1743187200000</edate>
    <id>2004</id>
    <nme>ATLAS: 结果处理</nme>
    <pri>5</pri>
    <rty>0</rty>

    <!-- Action 1: Read File — /sdcard/atlas_shared/last_result.json -->
    <Action sr="act0" ve="7">
      <code>417</code>
      <Str sr="arg0" ve="3">/sdcard/atlas_shared/last_result.json</Str>
      <Str sr="arg1" ve="3">%result_content</Str>
    </Action>

    <!-- Action 2: Variable Set — 默认 status = unknown -->
    <Action sr="act1" ve="7">
      <code>547</code>
      <Str sr="arg0" ve="3">%task_status</Str>
      <Str sr="arg1" ve="3">unknown</Str>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="0"/>
      <Int sr="arg5" val="0"/>
      <Int sr="arg6" val="0"/>
    </Action>

    <!-- Action 3: Variable Set — 默认 task_id -->
    <Action sr="act2" ve="7">
      <code>547</code>
      <Str sr="arg0" ve="3">%task_id</Str>
      <Str sr="arg1" ve="3">N/A</Str>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="0"/>
      <Int sr="arg5" val="0"/>
      <Int sr="arg6" val="0"/>
    </Action>

    <!-- Action 4: If — %result_content Is Set -->
    <Action sr="act3" ve="7">
      <code>37</code>
      <ConditionList sr="if">
        <Condition sr="c0" ve="3">
          <lhs>%result_content</lhs>
          <op>12</op>
          <rhs></rhs>
        </Condition>
      </ConditionList>
    </Action>

    <!-- Action 5: JavaScriptlet — 解析 JSON 提取 status 和 task_id (code=418) -->
    <!-- 原两个 code=413 均为"请求添加快捷图块"功能，不可用于 JSON 解析。
         合并为单个 JavaScriptlet，一次性提取所有字段。 -->
    <Action sr="act4" ve="7">
      <code>418</code>
      <Str sr="arg0" ve="3">try { var r = JSON.parse(local("result_content")); setLocal("task_status", r.status || "unknown"); setLocal("task_id", r.task_id || "N/A"); } catch(e) { setLocal("task_status", "parse_error"); setLocal("task_id", "N/A"); }</Str>
      <Int sr="arg1" val="30"/>
    </Action>

    <!-- Action 6: Notify — 显示结果 -->
    <Action sr="act5" ve="7">
      <code>523</code>
      <Str sr="arg0" ve="3">Atlas: 任务结果</Str>
      <Str sr="arg1" ve="3">任务: %task_id
状态: %task_status</Str>
      <Str sr="arg2" ve="3"/>
      <Str sr="arg3" ve="3"/>
      <Str sr="arg4" ve="3"/>
      <Str sr="arg5" ve="3">ic_menu_info_details</Str>
      <Int sr="arg6" val="0"/>
      <Int sr="arg7" val="0"/>
      <Int sr="arg8" val="0"/>
    </Action>

    <!-- Action 7: End If -->
    <Action sr="act6" ve="7">
      <code>38</code>
    </Action>
  </Task>
</TaskerData>

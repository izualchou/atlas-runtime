<?xml version="1.0" encoding="utf-8"?>
<TaskerData version="1.0" tv="5.15.0" dvi="1" rvi="1">
  <!-- ================================================================
       Profile: ATLAS 状态触发
       名称: ATLAS: 状态-电量低于20%
       触发: 电量从 >20% 降到 <=20%
       任务: ATLAS: WiFi切换 (关闭 WiFi 以省电)
       退出任务: ATLAS: WiFi切换 (恢复 WiFi)
       用途: 低电量时自动关闭耗电功能
  ================================================================ -->
  <Profile sr="prof_state" ve="2">
    <cdate>1723104000000</cdate>
    <edate>1743187200000</edate>
    <id>1003</id>
    <flags>8</flags>
    <mid0>1003</mid0>
    <nme>ATLAS: 状态-电量低于20%</nme>

    <!-- 电量上下文: 0-20% -->
    <BattLevel sr="con0" ve="2">
      <code>300</code>
      <from>0</from>
      <to>20</to>
    </BattLevel>

    <!-- 关联 Task (进入) -->
    <Task sr="task_wifi_toggle"/>

    <!-- 退出 Task (电量恢复 >20% 时) — 恢复 WiFi -->
    <ExitTask sr="task_wifi_toggle"/>
  </Profile>

  <!-- Task: ATLAS: WiFi切换 -->
  <Task sr="task_wifi_toggle">
    <cdate>1723104000000</cdate>
    <edate>1743187200000</edate>
    <id>2002</id>
    <nme>ATLAS: WiFi切换</nme>
    <pri>8</pri>
    <rty>1</rty>

    <!-- Action 1: Variable Set — %wifi_action -->
    <Action sr="act0" ve="7">
      <code>547</code>
      <Str sr="arg0" ve="3">%wifi_action</Str>
      <Str sr="arg1" ve="3">{"action":"wifi_toggle","params":{"enable":false},"correlation_id":"tasker_wifi_lowbatt_%TIMES"}</Str>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="0"/>
      <Int sr="arg5" val="0"/>
      <Int sr="arg6" val="0"/>
    </Action>

    <!-- Action 2: Termux:Tasker — trigger_atlas.sh -->
    <Action sr="act1" ve="7">
      <code>1342177284</code>
      <Bundle sr="arg0">
        <key>com.termux.tasker.ARGUMENTS</key>
        <value>runtime/trigger_atlas.sh %wifi_action</value>
        <key>com.termux.tasker.EXECUTABLE</key>
        <value>/data/data/com.termux/files/usr/bin/bash</value>
        <key>com.termux.tasker.TIMEOUT</key>
        <value>15</value>
        <key>com.termux.tasker.WORKDIR</key>
        <value>/data/data/com.termux/files/home/atlas-runtime</value>
      </Bundle>
      <Str sr="arg1" ve="3">com.termux.tasker</Str>
      <Str sr="arg2" ve="3">com.termux.tasker.TaskerReceiver</Str>
      <Int sr="arg3" val="0"/>
    </Action>

    <!-- Action 3: Wait 3s -->
    <Action sr="act2" ve="7">
      <code>30</code>
      <Int sr="arg0" val="3"/>
      <Int sr="arg1" val="0"/>
      <Int sr="arg2" val="0"/>
      <Int sr="arg3" val="0"/>
      <Int sr="arg4" val="0"/>
    </Action>

    <!-- Action 4: Notify -->
    <Action sr="act3" ve="7">
      <code>523</code>
      <Str sr="arg0" ve="3">Atlas: 低电量节电</Str>
      <Str sr="arg1" ve="3">WiFi 已关闭以节省电量</Str>
      <Str sr="arg2" ve="3"/>
      <Str sr="arg3" ve="3"/>
      <Str sr="arg4" ve="3"/>
      <Str sr="arg5" ve="3">ic_launcher</Str>
      <Int sr="arg6" val="0"/>
      <Int sr="arg7" val="0"/>
      <Int sr="arg8" val="0"/>
    </Action>
  </Task>
</TaskerData>
